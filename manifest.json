{
  "manifest_version": 3,
  "name": "Feed Hider for LinkedIn",
  "version": "1.0.0",
  "description": "Hides the LinkedIn home feed and takes you to Jobs instead. Stop scrolling and do something great.",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "css": [
        "hide.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
